[Unit]
Description=Vault Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vaultd --config-file /etc/vault/vaultd.conf --non-interactive

Restart=always
RestartSec=30

User=vault
Group=vault

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
